{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "tasks": {
    "dev": {
      "passThroughEnv": ["DATABASE_URL", "REDIS_URL", "NEXTAUTH_SECRET", "NEXTAUTH_URL", "WEB_ORIGIN", "CORS_ORIGIN", "API_PORT", "LOG_LEVEL", "SNMP_TRAP_*", "DISCOVERY_*"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "env": ["NEXT_PUBLIC_API_URL"],
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
