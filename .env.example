# Database and queue
DATABASE_URL=postgresql://netpulse:netpulse@localhost:5432/netpulse
REDIS_URL=redis://localhost:6379

# Generate a private signing secret before deployment. Also encrypts stored SSH keys.
NEXTAUTH_SECRET=your-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Browser-visible API URL; compiled into the web production build.
NEXT_PUBLIC_API_URL=http://localhost:4000

# App
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info

# Normal startup includes trap reception and periodic discovery.
# Development binds UDP 1162; Docker publishes host UDP 162 to container UDP 1162.
SNMP_TRAP_ENABLED=true
SNMP_TRAP_PORT=1162
SNMP_TRAP_COMMUNITY=public
SNMP_TRAP_USERS=[]
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL=3600

# AI provider credentials and notification transports are configured in the web UI.
# Legacy ANTHROPIC_API_KEY/SMTP_*/TELEGRAM_*/etc. variables do not create providers or channels.
